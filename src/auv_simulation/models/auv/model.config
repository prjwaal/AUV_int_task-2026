<?xml version="1.0"?>
<model>
  <name>auv</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Your Name</name>
    <email>you@example.com</email>
  </author>

  <description>
    Minimal torpedo-hull AUV used for the Software Head assessment's
    Simulation Environment item. One rigid link, neutrally buoyant, driven
    by Gazebo's built-in VelocityControl system (body-frame linear/angular
    velocity in, ground-truth odometry out) rather than a full thruster
    allocation model. See auv_simulation/README.md for the reasoning.
  </description>
</model>
