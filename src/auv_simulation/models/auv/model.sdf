<?xml version="1.0"?>
<sdf version="1.9">
  <model name="auv">
    <!-- No pose here: the spawn pose is set once, by the <include><pose>
         in auv_world.sdf, to keep it in one place. -->

    <!--
      Single rigid link. A full multi-body thruster/fin model was scoped out
      (see auv_simulation/README.md "Design decisions") — the ROS 2 side
      commands body-frame velocity, Gazebo's VelocityControl system tracks
      it, and the Buoyancy system (attached at the world level in
      auv_world.sdf) gives the hull a physically real neutral-buoyancy
      response to gravity when nothing is commanding it.
    -->
    <link name="base_link">
      <inertial>
        <!-- mass = pi * r^2 * L * rho_water, r=0.15m, L=1.0m, rho=1000kg/m^3
             -> neutrally buoyant against the world's <uniform_fluid_density> -->
        <mass>70.7</mass>
        <inertia>
          <ixx>6.29</ixx>
          <iyy>6.29</iyy>
          <izz>0.795</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Single collision = the buoyancy/physics volume. Cylinder's local
           z-axis is rotated onto the link's x-axis so "forward" is +x. -->
      <collision name="hull_collision">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="hull_visual">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.55 0.05 1</ambient>
          <diffuse>0.9 0.6 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Nose cone: visual only (no collision), so it does not perturb the
           buoyancy volume computed from hull_collision. -->
      <visual name="nose_visual">
        <pose>0.55 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.001</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Vertical fin, purely cosmetic: makes heading changes visible on
           the recorded demo video. -->
      <visual name="fin_visual">
        <pose>-0.4 0 0.13 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.02 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!--
      Body-frame linear/angular velocity in. Subscribes on
      /model/auv/cmd_vel (gz.msgs.Twist). This is the "actuation" boundary:
      real hardware integration replaces this plugin with an actual thruster
      allocator, without the ROS 2 side (vehicle_node / GazeboVehicleAdapter)
      changing at all, since it only ever publishes a body-frame Twist.
    -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/auv/cmd_vel</topic>
    </plugin>

    <!--
      Ground-truth pose/twist out, as nav_msgs/Odometry (via the ros_gz
      bridge) on /model/auv/odometry. This is what GazeboVehicleAdapter
      subscribes to in place of VehicleSimModel's internal kinematics.
    -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>auv/odom</odom_frame>
      <robot_base_frame>auv/base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
